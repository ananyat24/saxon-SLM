# mock (default) uses in-memory fixtures. live routes machine assessment,
# copilot Q&A, and what-if analysis to the real saxon_machine_health_api
# classifier backend (see src/api/live/); everything else (fleet KPIs,
# alerts, work orders, reports, confidence drift) stays on mock until a
# real backend exists for it — see DataSourceTag in the UI.
VITE_API_MODE=mock

# Base URL of the real backend's versioned API root when VITE_API_MODE=live.
# Must include the /api/v1 prefix, e.g. http://localhost:8000/api/v1 for a
# local saxon_machine_health_api instance, or its deployed URL in production.
# Never point this at a service that requires an API key in the frontend —
# the backend is responsible for holding any credentials it needs.
VITE_API_BASE_URL=http://localhost:8000/api/v1
